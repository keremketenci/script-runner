{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "script-runner",
  "version": "0.9.1",
  "identifier": "com.keremketenci.scriptrunner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "script-runner",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "publisher": "Kerem Ketenci",
    "copyright": "Copyright © 2026 Kerem Ketenci",
    "shortDescription": "Browse and run your personal scripts from one place",
    "longDescription": "A desktop app for browsing script folders and running scripts in an embedded terminal, with run settings, sequences and a run history."
  }
}
